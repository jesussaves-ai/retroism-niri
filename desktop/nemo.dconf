[preferences]
click-policy='double'
default-folder-viewer='list-view'
enable-delete=true
show-computer-icon-toolbar=false
show-edit-icon-toolbar=false
show-full-path-titles=true
show-hidden-files=false
show-home-icon-toolbar=false
show-show-thumbnails-toolbar=false
show-toggle-extra-pane-toolbar=true
sort-directories-first=true

[window-state]
sidebar-bookmark-breakpoint=4
start-with-location-bar=false
start-with-menu-bar=true
start-with-sidebar=true
start-with-status-bar=true
start-with-toolbar=true
